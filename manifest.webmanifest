{
  "name": "dotdiff — env file diff & dotenv validator",
  "short_name": "dotdiff",
  "description": "Compare two .env / config files in your browser and validate them for drift, duplicates and missing keys. 100% client-side.",
  "start_url": "/dotdiff/",
  "scope": "/dotdiff/",

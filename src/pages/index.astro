---
import '../styles/app.css';

// BASE_URL may or may not carry a trailing slash depending on config; normalize
// to exactly one so hand-written asset URLs never 404 under /dotdiff/.
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const site = 'https://sreenivas-sadhu-prabhakara.github.io';
const canonical = `${site}${base}`;
const ogImage = `${canonical}og.png`;

// ~55-char title and ~150-char description tuned for real long-tail demand
// ("compare .env files", "dotenv diff", "find missing env variables").
const title = 'dotdiff — compare .env files & dotenv validator';
const description =
  'Compare two .env files online and see the real differences — key order, whitespace and comments ignored. Finds missing, changed and duplicate keys. Private, in-browser.';

// Long-tail FAQs: real questions people search when diffing env files.
const faqs = [
  {
    q: 'How do I compare two .env files?',
    a: 'Paste one file into panel A and the other into panel B. dotdiff normalizes both — ignoring key order, whitespace, quotes and comments — then shows only the keys that are added, removed or changed between them.',
  },
  {
    q: 'Is dotdiff safe for secrets and API keys?',
    a: 'Yes. Everything runs in your browser and a strict Content-Security-Policy with connect-src ’none’ means the page cannot make any network request. Nothing you paste ever leaves your device. A "mask values" toggle also hides secret values in the report.',
  },
  {
    q: 'How can I find environment variables missing from one file?',
    a: 'The diff lists keys that exist only in A or only in B, so a variable present in production but absent in staging is flagged immediately. You can also list required keys to have dotdiff warn when either file is missing them.',
  },
  {
    q: 'Does dotdiff catch duplicate keys and empty values?',
    a: 'Yes. The built-in health check flags duplicate keys within a file, empty or unset values, and values whose type appears to have drifted (for example a port number that changed to text) — the kinds of mistakes that break a deploy.',
  },
  {
    q: 'Do I need to install or sign up for anything?',
    a: 'No. dotdiff is a single static page with no account, no upload and no server. Open it and paste — it works offline once loaded.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'dotdiff',
      url: canonical,
      description,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Any (web browser)',
      browserRequirements: 'Requires JavaScript',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      isAccessibleForFree: true,
      featureList: [
        'Compare two .env / config files',
        'Ignore key order, whitespace, quotes and comments',
        'Detect drift, duplicate keys and empty values',
        'Flag missing required environment variables',
        '100% client-side — nothing leaves the device',
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<html lang="en">
<head>
<!-- CSP is the brand: browser-enforced privacy. connect-src 'none' = nothing
     can ever be sent off-device. Astro emits CSS/JS as external hashed assets
     so no inline script or style is needed, keeping script-src 'self' clean. -->
<meta
  http-equiv="Content-Security-Policy"
  content="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'none'; base-uri 'self'; form-action 'none'; object-src 'none'"
/>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta
  name="keywords"
  content="env file diff, compare .env files, dotenv validator, find missing env variables, dotenv diff, config diff, environment variable compare"
/>
<meta name="robots" content="index, follow" />
<meta name="color-scheme" content="dark" />
<meta name="theme-color" content="#14181f" />
<link rel="canonical" href={canonical} />
<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
<link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
<link rel="manifest" href={`${base}manifest.webmanifest`} />

<!-- Open Graph / social -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="dotdiff" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="dotdiff comparing two .env files side by side, showing added, removed and changed keys" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Structured data: WebApplication + FAQPage (application/ld+json is not
     executable JS, so it is exempt from script-src 'self' — CSP stays clean). -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>

<a href="#input-a" class="sr-only">Skip to input</a>

<div class="wrap">
  <header class="masthead">
    <h1 class="brand">
      <span class="dot">dot</span><span class="diff">diff</span><span
        class="eq"
        aria-hidden="true">A=B</span
      >
    </h1>
    <p class="tagline">
      Paste two configs. See the <b>real</b> differences — order, whitespace and
      comments ignored.
    </p>
    <div class="masthead-right">
      <span class="seal" title="A strict Content-Security-Policy blocks all network access from this page.">
        <span class="seal-dot" aria-hidden="true"></span>
        <span><b>Private.</b> Nothing leaves this device.</span>
      </span>
    </div>
  </header>

  <!-- ================= control deck ================= -->
  <section class="deck" aria-label="Comparison options">
    <div class="deck-group" role="radiogroup" aria-label="Comparison mode">
      <span class="deck-label">Mode</span>
      <span class="segmented">
        <label>
          <input type="radio" name="mode" value="kv" checked />
          <span>KEY=VALUE</span>
        </label>
        <label>
          <input type="radio" name="mode" value="raw" />
          <span>Raw text</span>
        </label>
      </span>
    </div>

    <span class="deck-sep" aria-hidden="true"></span>

    <div class="deck-group" aria-label="Normalization options">
      <label class="toggle kv-only">
        <input type="checkbox" id="opt-case" class="opt-toggle" />
        <span>ignore key case</span>
      </label>
      <label class="toggle kv-only">
        <input type="checkbox" id="opt-quotes" class="opt-toggle" />
        <span>ignore quotes</span>
      </label>
      <label class="toggle kv-only">
        <input type="checkbox" id="opt-comments" class="opt-toggle" />
        <span>strip inline # comments</span>
      </label>
      <label class="toggle kv-only">
        <input type="checkbox" id="opt-empty" class="opt-toggle" />
        <span>empty == unset</span>
      </label>
      <label class="toggle raw-only" hidden>
        <input type="checkbox" id="opt-dedupe" class="opt-toggle" />
        <span>de-duplicate lines</span>
      </label>
      <label class="toggle toggle-mask">
        <input type="checkbox" id="opt-mask" />
        <span>mask values (secret-safe)</span>
      </label>
    </div>

    <div class="deck-actions">
      <button type="button" class="btn" id="btn-swap" title="Swap A and B">Swap A↔B</button>
      <button type="button" class="btn" id="btn-sample">Load sample</button>
      <button type="button" class="btn" id="btn-clear">Clear</button>
      <button type="button" class="btn" id="btn-copy" data-label="Copy report">Copy report</button>
      <button type="button" class="btn btn-primary" id="btn-download">Download .txt</button>
    </div>
  </section>

  <!-- ================= twin input panels ================= -->
  <section class="twin" aria-label="Configuration inputs">
    <div class="panel panel-a">
      <div class="panel-head">
        <span class="panel-badge" aria-hidden="true">A</span>
        <span class="panel-name">Config A</span>
        <span class="panel-hint">e.g. .env.production</span>
      </div>
      <label class="sr-only" for="input-a">Config A</label>
      <textarea
        id="input-a"
        class="code"
        spellcheck="false"
        autocapitalize="off"
        autocomplete="off"
        autocorrect="off"
        placeholder="KEY=value…"></textarea>
    </div>

    <div class="seam" aria-hidden="true"></div>

    <div class="panel panel-b">
      <div class="panel-head">
        <span class="panel-badge" aria-hidden="true">B</span>
        <span class="panel-name">Config B</span>
        <span class="panel-hint">e.g. .env.staging</span>
      </div>
      <label class="sr-only" for="input-b">Config B</label>
      <textarea
        id="input-b"
        class="code"
        spellcheck="false"
        autocapitalize="off"
        autocomplete="off"
        autocorrect="off"
        placeholder="KEY=value…"></textarea>
    </div>
  </section>

  <!-- ================= required keys ================= -->
  <details class="required kv-only">
    <summary>
      <b>Required keys</b>
      <span class="required-note">one per line — flags any missing on either side</span>
    </summary>
    <label class="sr-only" for="required-keys">Required keys, one per line</label>
    <textarea
      id="required-keys"
      spellcheck="false"
      autocapitalize="off"
      autocomplete="off"
      placeholder="DATABASE_URL&#10;JWT_SECRET&#10;STRIPE_KEY"></textarea>
  </details>

  <!-- ================= results ================= -->
  <div class="results">
    <section aria-label="Differences">
      <h2 class="section-title">Diff</h2>
      <div id="summary" class="summary" role="status" aria-live="polite"></div>
      <div id="diff-output" class="diff-output"></div>
    </section>

    <section id="validator-panel" aria-label="Validator">
      <h2 class="section-title">Health check</h2>
      <div id="validator-output" class="validator"></div>
    </section>
  </div>

  <footer class="foot">
    <p class="foot-privacy">
      <span class="seal-dot" aria-hidden="true"></span>
      Enforced by
      <code>connect-src 'none'</code>
      — this page has no way to make a network request. Parsing, diffing and the
      downloaded report all run in your browser.
    </p>
    <p class="foot-keys">
      dotdiff is a <b>.env / config diff &amp; validator</b>: compare .env files,
      find missing environment variables, and catch drift between environments —
      all offline.
    </p>
    <p class="foot-legal">
      MIT-licensed and provided <b>as is</b>, without warranty of any kind. You
      are responsible for verifying results before acting on them; the author is
      not liable for any loss arising from its use.
    </p>
  </footer>
</div>

<!-- External island. Astro bundles + hashes this and rewrites the src with the
     correct base, so it never 404s under /dotdiff/ and script-src 'self' holds. -->
<script src="../scripts/app.ts"></script>
</body>
</html>
